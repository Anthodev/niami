<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
    https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Model\Game\Game" table="games">
        <id name="id" type="uuid" column="id">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Symfony\Bridge\Doctrine\IdGenerator\UuidGenerator"/>
        </id>

        <field name="name" type="string" column="name" length="255">
        </field>

        <field name="slug" type="string" column="slug" length="255">
        </field>

        <field name="description" type="text" column="description">
        </field>

        <field name="releaseDate" type="string" column="releaseDate" length="255">
        </field>

        <field name="imageCover" type="string" column="imageCover" length="255">
        </field>

        <field name="isPatched" type="boolean" column="isPatched">
            <options>
                <option name="default">false</option>
            </options>
        </field>

        <field name="isActive" type="boolean" column="isActive">
            <options>
                <option name="default">true</option>
            </options>
        </field>

        <field name="createdAt" type="datetime_immutable" column="created_at">
            <options>
                <option name="default">NOW()</option>
            </options>
        </field>

        <field name="updatedAt" type="datetime" column="updated_at" nullable="true">
            <options>
                <option name="default">NOW()</option>
            </options>
        </field>

        <one-to-many
            field="reports"
            target-entity="App\Domain\Model\Report\Report"
            mapped-by="game"
        />

        <many-to-one
            field="publisher"
            target-entity="App\Domain\Model\Game\Publisher"
            inversed-by="games"
        />

        <indexes>
            <index name="games_name" columns="name"/>
            <index name="games_slug" columns="slug"/>
            <index name="games_publisher_id" columns="publisher_id"/>
        </indexes>

        <unique-constraints>
            <unique-constraint name="games_name_unique_constraint" columns="name"/>
            <unique-constraint name="games_slug_unique_constraint" columns="slug"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
