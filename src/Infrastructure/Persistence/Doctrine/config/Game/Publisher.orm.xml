<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
    https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
    <entity name="App\Domain\Model\Game\Publisher" table="publishers">
        <id name="id" type="uuid" column="id">
            <generator strategy="CUSTOM" />
            <custom-id-generator
                class="Symfony\Bridge\Doctrine\IdGenerator\UuidGenerator"
            />
        </id>

        <field name="name" type="string" column="name" length="255">
        </field>

        <field
            name="website"
            type="string"
            column="website"
            length="255"
            nullable="true"
        >
        </field>

        <field name="apiId" type="integer" column="apiId">
        </field>

        <field name="createdAt" type="datetime_immutable" column="created_at">
            <options>
                <option name="default">NOW()</option>
            </options>
        </field>

        <field
            name="updatedAt"
            type="datetime"
            column="updated_at"
            nullable="true"
        >
            <options>
                <option name="default">NOW()</option>
            </options>
        </field>

        <one-to-many
            field="games"
            target-entity="App\Domain\Model\Game\Game"
            mapped-by="publisher"
        />

        <indexes>
            <index name="publishers_name" columns="name" />
        </indexes>

        <unique-constraints>
            <unique-constraint
                name="publishers_name_unique_constraint"
                columns="name"
            />
        </unique-constraints>
    </entity>
</doctrine-mapping>
