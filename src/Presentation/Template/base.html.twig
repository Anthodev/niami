<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Nintendo Switch 2 Unofficial Back-Compatibility Reports{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎮</text></svg>">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-base-200 min-h-screen" data-controller="turbo-loading" data-turbo-loading-min-length-value="3">
<div class="navbar bg-base-100 shadow-lg">
    <div class="navbar-start">
        <a href="{{ path('homepage') }}" class="btn btn-ghost normal-case text-xl">🎮 NS2 UBCR</a>
    </div>
    <div class="navbar-end">
        <div class="flex items-center gap-2" data-controller="theme">
            <span class="text-sm">🌞</span>
            <input type="checkbox" class="toggle toggle-primary" data-theme-target="toggle" data-action="change->theme#toggle" />
            <span class="text-sm">🌙</span>
        </div>
    </div>
</div>

<main class="container mx-auto px-4">
    {% block content %}
    {% endblock %}
</main>

<footer class="footer footer-center p-10 bg-base-200 text-base-content rounded mt-10">
    <div class="grid grid-flow-col gap-4">
        <p>Copyright © 2024 - Nintendo Switch 2 Unofficial Back-Compatibility Reports</p>
    </div>
</footer>

</body>
</html>
