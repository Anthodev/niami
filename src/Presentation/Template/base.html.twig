{% trans_default_domain 'home' %}

<!DOCTYPE html>
<html lang="fr" data-theme="plumber-dark" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'content.title'|trans }}{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎮</text></svg>">
    <meta name="description" content="Discover Nintendo Switch games compatibility reports for Nintendo Switch 2. Community-driven database of gaming experiences and performance insights.">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-gradient-to-br from-base-200 via-base-200 to-base-300 min-h-screen antialiased" data-controller="turbo-loading" data-turbo-loading-min-length-value="3">
    <div class="min-h-screen flex flex-col">
        {% include '@app/partials/_header.html.twig' %}

        <main class="flex-1 container mx-auto px-4 sm:px-6 lg:px-8 py-8">
            {% block content %}
            {% endblock %}
        </main>

        {% include '@app/partials/_footer.html.twig' %}
    </div>
</body>
</html>
