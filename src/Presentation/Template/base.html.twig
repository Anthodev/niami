<!DOCTYPE html>
<html lang="fr" data-theme="plumber-dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Nintendo Switch 2 Unofficial Back-Compatibility Reports{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎮</text></svg>">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-base-200 min-h-screen" data-controller="turbo-loading" data-turbo-loading-min-length-value="3">
{% include '@app/partials/_header.html.twig' %}

<main class="container mx-auto px-4">
    {% block content %}
    {% endblock %}
</main>

{% include '@app/partials/_footer.html.twig' %}

</body>
</html>
