{% set modal_index = 'report-comment-modal' %}
{% macro check_cell(value) %}
    <div class="mx-auto grid h-8 w-8 place-items-center rounded-full {{ value ? 'bg-success/10 text-success' : 'bg-base-200 text-base-content/35' }}" aria-label="{{ value ? 'Yes' : 'No' }}">
        {{ value ? ux_icon('ph:check', {class: 'h-4 w-4'}) : ux_icon('ph:x', {class: 'h-4 w-4'}) }}
    </div>
{% endmacro %}

{% include '@reports/partials/_reports_list_header.html.twig' %}

{% for report in reports %}
    {% set statusName = report.gameStatus.name %}
    {% set statusIcon = 'ph:sparkle' %}
    {% set statusBadge = 'badge-success' %}

    {% if statusName == 'OK' %}
        {% set statusIcon = 'ph:smiley' %}
        {% set statusBadge = 'badge-info' %}
    {% elseif statusName == 'BAD' %}
        {% set statusIcon = 'ph:smiley-nervous' %}
        {% set statusBadge = 'badge-warning' %}
    {% elseif statusName == 'BUGGED' %}
        {% set statusIcon = 'ph:smiley-x-eyes' %}
        {% set statusBadge = 'badge-error' %}
    {% endif %}

    <tr class="border-b border-base-300/60 transition hover:bg-base-200/70 {{ loop.first ? 'bg-warning/5' : '' }}">
        <td class="sticky left-0 z-10 bg-inherit py-3 text-center">
            <span class="badge {{ statusBadge }} gap-1 whitespace-nowrap">
                {{ ux_icon(statusIcon, {class: 'h-4 w-4'}) }}
                {{ statusName }}
            </span>
        </td>

        <td class="py-3 text-center">{{ _self.check_cell(report.is60FpsPortable) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.hasStableFrameratePortable) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.hasResolutionImprovedPortable) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.isNativeResolutionPortable) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.is60FpsDocked) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.hasStableFramerateDocked) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.hasResolutionImprovedDocked) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.isNativeResolutionDocked) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.hasImprovedLoadingTimes) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.isPatched) }}</td>
        <td class="py-3 text-center">{{ _self.check_cell(report.switch2Edition) }}</td>

        <td class="py-3 text-center">
            <turbo-frame class="flex justify-center" id="report-{{ report.id }}">
                <div data-report-upvote data-report-id="{{ report.id }}" class="inline-flex items-center gap-2">
                    <a href="{{ path('report_increase_upvote', {id: report.id}) }}"
                        data-turbo-method="patch"
                        data-turbo-frame="report-{{ report.id }}"
                        class="btn btn-ghost btn-sm rounded-full text-base-content/70 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary/50"
                        aria-label="{{ 'list.table.header.upvoted'|trans }}"
                    >
                        <span id="upvote-count-{{ report.id }}" class="font-semibold">{{ report.upvoteCount }}</span>
                        {{ ux_icon('ph:arrow-up', {class: 'h-4 w-4'}) }}
                    </a>
                    {% if loop.first %}
                        <span class="tooltip text-warning" data-tip="{{ 'list.legends.most_upvoted'|trans }}" aria-label="{{ 'list.legends.most_upvoted'|trans }}">
                            {{ ux_icon('ph:star-fill', {class: 'h-5 w-5'}) }}
                        </span>
                    {% endif %}
                </div>
            </turbo-frame>
        </td>

        <td class="py-3 text-center">
            <button class="btn btn-ghost btn-sm btn-circle text-base-content/50 hover:text-warning focus-visible:outline focus-visible:outline-2 focus-visible:outline-warning/50"
                    type="button"
                    data-report-id="{{ report.id }}"
                    data-game-slug="{{ report.game.slug }}"
                    data-report-path="{{ path('create_report_comment', { reportId: report.id }) }}"
                    data-action="report-comment-modal#open"
                    aria-label="{{ 'list.table.header.issue'|trans }}">
                {{ ux_icon('ph:warning', {class: 'h-5 w-5'}) }}
            </button>
        </td>
    </tr>
{% endfor %}

{% include '@reports/partials/_reports_list_footer.html.twig' %}
