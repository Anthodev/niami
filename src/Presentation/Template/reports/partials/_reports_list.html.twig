{% include '@reports/partials/_reports_list_header.html.twig' %}
{% set modal_index = 'report-comment-modal' %}
{% include '@reports/partials/_reports_comment_modal.html.twig' with { modal_index: modal_index } %}

{% for report in reports %}
    {% set status = report.gameStatus %}
    {% set statusBg = '' %}
    {% set statusIcon = '' %}

    {% if status == enum('App\\Infrastructure\\Enum\\ReportGameStatusEnum').OK %}
        {% set statusIcon = 'ph:smiley' %}
        {% set statusBg = 'text-success' %}
    {% elseif status == enum('App\\Infrastructure\\Enum\\ReportGameStatusEnum').BUGGED %}
        {% set statusIcon = 'ph:smiley-x-eyes' %}
        {% set statusBg = 'text-primary' %}
    {% elseif status == enum('App\\Infrastructure\\Enum\\ReportGameStatusEnum').BAD %}
        {% set statusIcon = 'ph:smiley-nervous' %}
        {% set statusBg = 'text-warning' %}
    {% else %}
        {% set statusIcon = 'ph:sparkle' %}
        {% set statusBg = 'text-info' %}
    {% endif %}

    {% set mostUpvotedBg = 'bg-primary/5' %}

    <tr class="border-b border-base-300/50 hover:bg-base-200/50 transition-colors {{ loop.first ? mostUpvotedBg : '' }}">
        <td class="py-3 text-center">
            <div class="w-5 h-5 mx-auto {{ statusBg }}">
                {{ ux_icon(statusIcon) }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.is60FpsPortable ? 'text-success' : 'text-base-content/30' }}">
                {{ report.is60FpsPortable ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.hasStableFrameratePortable ? 'text-success' : 'text-base-content/30' }}">
                {{ report.hasStableFrameratePortable ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.hasResolutionImprovedPortable ? 'text-success' : 'text-base-content/30' }}">
                {{ report.hasResolutionImprovedPortable ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.isNativeResolutionPortable ? 'text-success' : 'text-base-content/30' }}">
                {{ report.isNativeResolutionPortable ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.is60FpsDocked ? 'text-success' : 'text-base-content/30' }}">
                {{ report.is60FpsDocked ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.hasStableFramerateDocked ? 'text-success' : 'text-base-content/30' }}">
                {{ report.hasStableFramerateDocked ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.hasResolutionImprovedDocked ? 'text-success' : 'text-base-content/30' }}">
                {{ report.hasResolutionImprovedDocked ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.isNativeResolutionDocked ? 'text-success' : 'text-base-content/30' }}">
                {{ report.isNativeResolutionDocked ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.hasImprovedLoadingTimes ? 'text-success' : 'text-base-content/30' }}">
                {{ report.hasImprovedLoadingTimes ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.isPatched ? 'text-success' : 'text-base-content/30' }}">
                {{ report.isPatched ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <div class="w-4 h-4 mx-auto {{ report.switch2Edition ? 'text-success' : 'text-base-content/30' }}">
                {{ report.switch2Edition ? ux_icon('ph:check') : ux_icon('ph:x') }}
            </div>
        </td>

        <td class="py-3 text-center">
            <turbo-frame class="flex justify-center items-center gap-1" id="report-{{ report.id }}">
                <div data-report-upvote data-report-id="{{ report.id }}">
                    <a href="{{ path('report_increase_upvote', {id: report.id}) }}"
                        data-turbo-method="patch"
                        data-turbo-frame="report-{{ report.id }}"
                        class="flex items-center gap-1 text-sm text-base-content/60 hover:text-primary transition-colors"
                    >
                        <span id="upvote-count-{{ report.id }}">{{ report.upvoteCount }}</span>
                        <span class="w-4 h-4">{{ ux_icon('ph:arrow-up') }}</span>
                    </a>
                </div>
                {% if loop.first %}
                    <span class="w-4 h-4 text-warning">{{ ux_icon('ph:star-fill') }}</span>
                {% endif %}
            </turbo-frame>
        </td>

        <td class="py-3 text-center">
            <button class="w-6 h-6 text-base-content/40 hover:text-warning transition-colors"
                    data-report-id="{{ report.id }}"
                    data-game-slug="{{ report.game.slug }}"
                    data-report-path="{{ path('create_report_comment', { reportId: report.id }) }}"
                    onclick="openReportCommentModal(this)">
                {{ ux_icon('ph:warning') }}
            </button>
        </td>
    </tr>
{% endfor %}

{% include '@reports/partials/_reports_list_footer.html.twig' %}

{% block javascripts %}
    <script type="text/javascript">
        function openReportCommentModal(button) {
            const modal = document.getElementById('comment_report-comment-modal');
            const reportId = button.dataset.reportId;
            const gameSlug = button.dataset.gameSlug;
            const reportPath = button.dataset.reportPath;

            if (!modal) {
                console.error('Modal not found!');
                return;
            }

            const form = modal.querySelector('form');
            if (!form) {
                console.error('Form not found in modal!');
                return;
            }

            const basePath = form.getAttribute('data-base-path');
            if (basePath) {
                form.action = basePath.replace('REPORT_ID_PLACEHOLDER', reportId);
            }

            form.action = reportPath;

            let gameSlugInput = document.getElementById('create_report_comment_form_gameSlug');
            gameSlugInput.value = gameSlug;

            modal.showModal();
        }
    </script>
{% endblock %}
