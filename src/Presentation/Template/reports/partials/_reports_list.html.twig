{% include '@reports/partials/_reports_list_header.html.twig' %}
{% set modal_index = 'report-comment-modal' %}
{% include '@reports/partials/_reports_comment_modal.html.twig' with { modal_index: modal_index } %}

{% for report in reports %}
    {% set status = report.gameStatus %}
    {% set statusBg = '' %}
    {% set statusIcon = '' %}

    {% if status == enum('App\\Infrastructure\\Enum\\ReportGameStatusEnum').OK %}
        {% set statusIcon = 'ph:smiley' %}
        {% set statusBg = 'bg-info/50' %}
    {% elseif status == enum('App\\Infrastructure\\Enum\\ReportGameStatusEnum').BUGGED %}
        {% set statusIcon = 'ph:smiley-x-eyes' %}
        {% set statusBg = 'bg-primary/50' %}
    {% elseif status == enum('App\\Infrastructure\\Enum\\ReportGameStatusEnum').BAD %}
        {% set statusIcon = 'ph:smiley-nervous' %}
        {% set statusBg = 'bg-warning/50' %}
    {% else %}
        {% set statusIcon = 'ph:sparkle' %}

        {% set statusBg = 'bg-success/50' %}
    {% endif %}

    {% set mostUpvotedBg = 'bg-gradient-to-b from-amber-100 via-amber-200 to-amber-100 dark:from-amber-900/20 dark:via-amber-800/30 dark:to-amber-900/20' %}

    <tr class="border-l-4 {{ statusIcon }}">
        <td class="text-center hover:bg-base-300 {{ statusBg }}">
            <div class="w-6 h-6 mx-auto">
                {{ ux_icon(statusIcon) }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.is60FpsPortable ? 'text-green-400' : 'text-red-400' }}">
                {{ report.is60FpsPortable ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.hasStableFrameratePortable ? 'text-green-400' : 'text-red-400' }}">
                {{ report.hasStableFrameratePortable ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.hasResolutionImprovedPortable ? 'text-green-400' : 'text-red-400' }}">
                {{ report.hasResolutionImprovedPortable ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.isNativeResolutionPortable ? 'text-green-400' : 'text-red-400' }}">
                {{ report.isNativeResolutionPortable ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.is60FpsDocked ? 'text-green-400' : 'text-red-400' }}">
                {{ report.is60FpsDocked ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-30 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.hasStableFramerateDocked ? 'text-green-400' : 'text-red-400' }}">
                {{ report.hasStableFramerateDocked ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.hasResolutionImprovedDocked ? 'text-green-400' : 'text-red-400' }}">
                {{ report.hasResolutionImprovedDocked ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.isNativeResolutionDocked ? 'text-green-400' : 'text-red-400' }}">
                {{ report.isNativeResolutionDocked ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.hasImprovedLoadingTimes ? 'text-green-400' : 'text-red-400' }}">
                {{ report.hasImprovedLoadingTimes ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.isPatched ? 'text-green-400' : 'text-red-400' }}">
                {{ report.isPatched ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="text-center hover:bg-base-300 {{ loop.first ? mostUpvotedBg : '' }}">
            <div class="w-6 h-6 mx-auto {{ report.switch2Edition ? 'text-green-400' : 'text-red-400' }}">
                {{ report.switch2Edition ? ux_icon('ph:check-square') : ux_icon('ph:x-square') }}
            </div>
        </td>

        <td class="flex justify-center hover:bg-base-300 text-center {{ loop.first ? mostUpvotedBg : '' }}">
            <turbo-frame class="flex" id="report-{{ report.id }}">
                <div data-report-upvote data-report-id="{{ report.id }}">
                    <a href="{{ path('report_increase_upvote', {id: report.id}) }}"
                        data-turbo-method="patch"
                        data-turbo-frame="report-{{ report.id }}"
                        class="flex cursor-pointer group text-decoration-none"
                    >
                        <div id="upvote-count-{{ report.id }}" class="bg-inherit">{{ report.upvoteCount }}</div>
                        <div class="w-6 h-6 bg-inherit text-green-200 group-hover:text-green-700 ml-1">
                            {{ ux_icon('ph:arrow-fat-up-duotone') }}
                        </div>
                    </a>
                </div>
                {% if loop.first %}
                    <div class="w-6 h-6 bg-inherit text-yellow-300 ml-1">{{ ux_icon('ph:star-fill') }}</div>
                {% endif %}
            </turbo-frame>
        </td>

        <td class="text-center hover:bg-base-300">
            <div class="w-6 h-6 mx-auto">
                <button class="btn text-warning btn-square -m-2"
                        data-report-id="{{ report.id }}"
                        data-game-slug="{{ report.game.slug }}"
                        data-report-path="{{ path('create_report_comment', { reportId: report.id }) }}"
                        onclick="openReportCommentModal(this)">
                    {{ ux_icon('ph:warning') }}
                </button>
            </div>
        </td>
    </tr>
{% endfor %}

{% include '@reports/partials/_reports_list_footer.html.twig' %}

{% block javascripts %}
    <script type="text/javascript">
        function openReportCommentModal(button) {
            const modal = document.getElementById('comment_report-comment-modal');
            const reportId = button.dataset.reportId;
            const gameSlug = button.dataset.gameSlug;
            const reportPath = button.dataset.reportPath;

            if (!modal) {
                console.error('Modal not found!');
                return;
            }

            const form = modal.querySelector('form');
            if (!form) {
                console.error('Form not found in modal!');
                return;
            }

            const basePath = form.getAttribute('data-base-path');
            if (basePath) {
                form.action = basePath.replace('REPORT_ID_PLACEHOLDER', reportId);
            }

            form.action = reportPath;

            let gameSlugInput = document.getElementById('create_report_comment_form_gameSlug');
            gameSlugInput.value = gameSlug;

            modal.showModal();
        }
    </script>

{% endblock %}
