{% trans_default_domain 'report' %}
{% import '@macro/_ordinal_macro.html.twig' as ordinal %}

<section class="app-card overflow-hidden" data-controller="report-comment-modal">
    <div class="card-body p-0">
        <div class="space-y-4 border-b border-base-300/70 p-4 sm:p-5">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <h2 class="text-lg font-semibold text-base-content">{{ 'list.legends.label'|trans }}</h2>
                    <p class="text-sm text-base-content/60">{{ 'list.legends.notice'|trans }}</p>
                </div>
                <span class="badge badge-primary badge-outline">{{ reports|length }} reports</span>
            </div>

            <div class="flex flex-wrap gap-2 text-xs">
                <span class="badge badge-success gap-1">{{ ux_icon('ph:sparkle', {class: 'h-4 w-4'}) }} {{ 'list.legends.running_better'|trans }}</span>
                <span class="badge badge-info gap-1">{{ ux_icon('ph:smiley', {class: 'h-4 w-4'}) }} {{ 'list.legends.running_same'|trans }}</span>
                <span class="badge badge-warning gap-1">{{ ux_icon('ph:smiley-nervous', {class: 'h-4 w-4'}) }} {{ 'list.legends.running_worse'|trans }}</span>
                <span class="badge badge-error gap-1">{{ ux_icon('ph:smiley-x-eyes', {class: 'h-4 w-4'}) }} {{ 'list.legends.is_bugged'|trans }}</span>
                <span class="badge badge-secondary gap-1">{{ ux_icon('ph:star-fill', {class: 'h-4 w-4'}) }} {{ 'list.legends.most_upvoted'|trans }}</span>
            </div>
        </div>

{% if reports|length > 0 %}
        <div class="overflow-x-auto">
            <table class="table table-sm min-w-[72rem]">
                <thead class="bg-base-200/80 text-xs uppercase tracking-wide text-base-content/70">
                    <tr>
                        <th class="sticky left-0 z-10 bg-base-200/95 text-center">{{ 'list.table.header.status'|trans }}</th>
                        <th colspan="4" class="text-center text-secondary">{{ 'list.table.header.portable_label'|trans }}</th>
                        <th colspan="4" class="text-center text-primary">{{ 'list.table.header.tv_label'|trans }}</th>
                        <th colspan="3" class="text-center text-accent">{{ 'list.table.header.misc_label'|trans }}</th>
                        <th class="text-center">{{ 'list.table.header.upvoted'|trans }}</th>
                        <th class="text-center">{{ 'list.table.header.issue'|trans }}</th>
                    </tr>
                    <tr>
                        <th class="sticky left-0 z-10 bg-base-200/95"></th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.60fps'|trans) }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.stable_FPS'|trans) }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.better_resolution'|trans) }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.native_resolution'|trans) }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.60fps'|trans) }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.stable_FPS'|trans) }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.better_resolution'|trans) }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.native_resolution'|trans) }}</th>
                        <th class="text-center">{{ 'list.table.header.better_loading_times'|trans }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.is_patched'|trans) }}</th>
                        <th class="text-center">{{ ordinal.ordinal('list.table.header.switch_2_edition'|trans) }}</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
{% endif %}
