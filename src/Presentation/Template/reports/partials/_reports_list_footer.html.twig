{% trans_default_domain 'report' %}
{% if reports|length > 0 %}
                </tbody>
            </table>
        </div>

        <div class="p-4 text-xs text-base-content/60">
            <p class="mb-3 font-semibold uppercase tracking-wide text-base-content/50">{{ 'list.table.icon_legend'|trans }}</p>
            <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                <p class="flex items-start gap-2">{{ ux_icon('ph:gauge', {class: 'mt-0.5 h-4 w-4 shrink-0 text-base-content/70'}) }} <span>{{ 'list.table.notice.60fps'|trans }}</span></p>
                <p class="flex items-start gap-2">{{ ux_icon('ph:activity', {class: 'mt-0.5 h-4 w-4 shrink-0 text-base-content/70'}) }} <span>{{ 'list.table.notice.stable_FPS'|trans }}</span></p>
                <p class="flex items-start gap-2">{{ ux_icon('ph:arrows-out', {class: 'mt-0.5 h-4 w-4 shrink-0 text-base-content/70'}) }} <span>{{ 'list.table.notice.better_resolution'|trans }}</span></p>
                <p class="flex items-start gap-2">{{ ux_icon('ph:monitor', {class: 'mt-0.5 h-4 w-4 shrink-0 text-base-content/70'}) }} <span>{{ 'list.table.notice.native_resolution'|trans }}</span></p>
                <p class="flex items-start gap-2">{{ ux_icon('ph:clock-countdown', {class: 'mt-0.5 h-4 w-4 shrink-0 text-base-content/70'}) }} <span>{{ 'list.table.notice.better_loading_times'|trans }}</span></p>
                <p class="flex items-start gap-2">{{ ux_icon('ph:wrench', {class: 'mt-0.5 h-4 w-4 shrink-0 text-base-content/70'}) }} <span>{{ 'list.table.notice.is_patched'|trans }}</span></p>
                <p class="flex items-start gap-2">{{ ux_icon('ph:seal-check', {class: 'mt-0.5 h-4 w-4 shrink-0 text-base-content/70'}) }} <span>{{ 'list.table.notice.switch_2_edition'|trans }}</span></p>
            </div>
        </div>
{% else %}
        <div class="p-8 text-center sm:p-10">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-primary/10 text-primary">
                {{ ux_icon('ph:clipboard-text', {class: 'h-7 w-7'}) }}
            </div>
            <p class="mt-3 text-lg font-semibold text-base-content">{{ 'list.empty.title'|trans }}</p>
            <p class="mx-auto mt-1 max-w-md text-sm text-base-content/60">{{ 'list.empty.description'|trans }}</p>
            <label for="report-create-toggle" class="app-button-primary mt-5 inline-flex cursor-pointer">
                {{ ux_icon('ph:plus', {class: 'h-4 w-4'}) }}
                {{ 'add_report.label'|trans }}
            </label>
        </div>
{% endif %}

