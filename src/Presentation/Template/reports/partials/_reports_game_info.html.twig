{% trans_default_domain 'report' %}
{% set hasCover = game.imageCover is defined and game.imageCover and game.name is defined %}

<section class="app-card overflow-hidden">
    <div class="grid gap-0 {{ hasCover ? 'lg:grid-cols-[minmax(16rem,18rem)_1fr] lg:items-stretch' : '' }}">
        {% if hasCover %}
            {% set coverUrl = game.imageCover|replace({'/t_thumb/': '/t_cover_big_2x/', '/t_cover_small/': '/t_cover_big_2x/'}) %}
            <div class="flex items-start justify-center border-b border-base-300/60 bg-base-200/35 p-5 sm:p-6 lg:border-b-0 lg:border-r lg:p-6">
                <figure class="mx-auto h-72 w-full max-w-[16rem] overflow-hidden rounded-box shadow-xl ring-1 ring-base-300/60 lg:h-80 lg:max-w-[14rem]">
                    <img
                        src="{{ coverUrl }}"
                        alt="{{ game.name }}"
                        class="h-full w-full object-cover"
                        loading="lazy"
                    >
                </figure>
            </div>
        {% endif %}
        <div class="space-y-4 bg-base-100 p-5 sm:p-6 lg:p-7">
            {% if game.name is defined and game.name %}
                <div class="space-y-3">
                    <h1 class="text-3xl font-bold tracking-tight text-base-content sm:text-4xl">
                        {{ game.name }}
                    </h1>
                    <div class="h-px bg-base-300/70" aria-hidden="true"></div>
                </div>
            {% endif %}

            <dl class="grid gap-3 sm:grid-cols-3">
                <div class="app-surface rounded-box p-3">
                    <dt class="text-xs uppercase tracking-wide text-base-content/60">{{ 'game.release_date'|trans }}</dt>
                    <dd class="mt-1 font-medium text-base-content">{{ game.releaseDate|date('d/m/Y') }}</dd>
                </div>

                {% if game.developer is defined and game.developer != '' %}
                    <div class="app-surface rounded-box p-3">
                        <dt class="text-xs uppercase tracking-wide text-base-content/60">{{ 'game.developer'|trans }}</dt>
                        <dd class="mt-1 font-medium text-base-content">{{ game.developer.name|default(game.developer) }}</dd>
                    </div>
                {% endif %}

                {% if game.publisher is defined and game.publisher != '' %}
                    <div class="app-surface rounded-box p-3">
                        <dt class="text-xs uppercase tracking-wide text-base-content/60">{{ 'game.publisher'|trans }}</dt>
                        <dd class="mt-1 font-medium text-base-content">{{ game.publisher.name|default(game.publisher) }}</dd>
                    </div>
                {% endif %}
            </dl>

            {% include '@reports/partials/_reports_top_report.html.twig' %}

            {% if game.description is defined and game.description %}
                {% set safeDescription = game.description|replace({
                    '<br><br>': "\n", '<br><br/>': "\n", '<br><br />': "\n",
                    '<br/><br>': "\n", '<br/><br/>': "\n", '<br/><br />': "\n",
                    '<br /><br>': "\n", '<br /><br/>': "\n", '<br /><br />': "\n",
                    '<br>': " ", '<br/>': " ", '<br />': " "
                })|striptags %}
                <section class="space-y-2 border-t border-base-300/60 pt-4">
                    <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/70">{{ 'game.description'|trans }}</h2>
                    <p class="text-sm leading-normal text-base-content/80">{{ safeDescription|nl2br }}</p>
                </section>
            {% endif %}
        </div>
    </div>
</section>
