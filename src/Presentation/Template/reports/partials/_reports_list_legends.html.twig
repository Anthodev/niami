{% trans_default_domain 'report' %}

<div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100 mt-4">
    <table class="table w-full">
        <thead>
        <tr>
            <th colspan="15">{{ 'list.legends.label'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        <tr class="max-h-6">
            <td class="flex justify-center bg-success/50"><div class="w-6 h-6">{{ ux_icon('ph:sparkle') }}</div></td>
            <td>{{ 'list.legends.running_better'|trans }}</td>
            <td class="w-2"></td>
            <td class="flex justify-center bg-info/50"><div class="w-6 h-6">{{ ux_icon('ph:smiley') }}</div></td>
            <td>{{ 'list.legends.running_same'|trans }}</td>
            <td class="w-2"></td>
            <td class="flex justify-center bg-warning/50"><div class="w-6 h-6">{{ ux_icon('ph:smiley-nervous') }}</div></td>
            <td>{{ 'list.legends.running_worse'|trans }}</td>
            <td class="w-2"></td>
            <td class="flex justify-center bg-primary/50"><div class="w-6 h-6">{{ ux_icon('ph:smiley-x-eyes') }}</div></td>
            <td>{{ 'list.legends.is_bugged'|trans }}</td>
            <td class="w-2"></td>
            <td class="flex justify-center"><div class="w-6 h-6 text-yellow-300">{{ ux_icon('ph:star-fill') }}</div></td>
            <td>{{ 'list.legends.most_upvoted'|trans }}</td>
            <td class="w-2"></td>
        </tr>
        </tbody>
    </table>
</div>

<div class="text-base-content/50 mb-4">
    <p>{{ 'list.legends.notice'|trans }}</p>
</div>
