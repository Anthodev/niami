{% trans_default_domain 'report' %}

<div class="mt-4">
    <div class="flex flex-wrap gap-2">
        <span class="badge badge-success gap-1">{{ ux_icon('ph:sparkle', {class: 'w-4 h-4'}) }} {{ 'list.legends.running_better'|trans }}</span>
        <span class="badge badge-info gap-1">{{ ux_icon('ph:smiley', {class: 'w-4 h-4'}) }} {{ 'list.legends.running_same'|trans }}</span>
        <span class="badge badge-warning gap-1">{{ ux_icon('ph:smiley-nervous', {class: 'w-4 h-4'}) }} {{ 'list.legends.running_worse'|trans }}</span>
        <span class="badge badge-primary gap-1">{{ ux_icon('ph:smiley-x-eyes', {class: 'w-4 h-4'}) }} {{ 'list.legends.is_bugged'|trans }}</span>
        <span class="badge badge-secondary gap-1">{{ ux_icon('ph:star-fill', {class: 'w-4 h-4'}) }} {{ 'list.legends.most_upvoted'|trans }}</span>
    </div>
</div>

<div class="text-base-content/50 text-sm mt-2 mb-4">
    {{ 'list.legends.notice'|trans }}
</div>
