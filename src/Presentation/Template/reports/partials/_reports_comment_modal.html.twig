{% trans_default_domain 'reportComment' %}

<dialog id="comment_{{ modal_index }}" class="modal">
  <div class="modal-box bg-base-100">
    <h3 class="font-bold text-lg">{{ 'reports.modal.title'|trans }}</h3>

    <div class="modal-action flex flex-col gap-4">
        {{ form_start(createReportCommentForm, {
            'action': path('create_report_comment', { reportId: 'REPORT_ID_PLACEHOLDER' }),
            'method': 'POST',
            'id': 'comment-form-' ~ modal_index,
        }) }}

        {{ form_widget(createReportCommentForm.comment, {
            'attr': {
                'class': 'textarea textarea-bordered w-full'
            }
        }) }}

        {{ form_widget(createReportCommentForm.gameSlug, {
            'attr': {
                'placeholder': 'Game slug will be set dynamically'
            }
        }) }}

        {{ form_widget(createReportCommentForm.ip, {
            'attr': {
                'value': app.request.clientIp,
            }
        }) }}

        {{ form_rest(createReportCommentForm) }}

        <div class="flex gap-2 justify-end">
            <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('comment_{{ modal_index }}').close()">{{ 'reports.modal.close'|trans }}</button>
            <button class="btn btn-primary btn-sm">{{ 'reports.modal.submit'|trans }}</button>
        </div>

        {{ form_end(createReportCommentForm) }}
    </div>
  </div>
</dialog>
