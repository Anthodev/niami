{% trans_default_domain 'report' %}

{% set checkboxClass = 'checkbox checkbox-primary checkbox-sm shrink-0' %}
{% set checkboxLabelClass = 'flex min-h-10 items-center gap-2 rounded-box border border-base-300/70 bg-base-100 px-3 py-2 text-sm transition hover:border-primary/40 hover:bg-base-200/60 focus-within:outline focus-within:outline-2 focus-within:outline-primary/40' %}

<section class="app-card" data-controller="report-form" id="add-report">
    <div class="collapse collapse-arrow">
        <input id="report-create-toggle" type="checkbox" aria-label="{{ 'add_report.label'|trans }}" />
        <div class="collapse-title flex items-center gap-3 px-4 py-3 text-base font-semibold sm:px-5">
            <span class="grid h-8 w-8 place-items-center rounded-box bg-primary/10 text-primary">
                {{ ux_icon('ph:plus-square', {class: 'h-5 w-5'}) }}
            </span>
            <span>{{ 'add_report.label'|trans }}</span>
        </div>

        <div class="collapse-content">
            {{ form_start(createReportForm, {
                'action': path('create_report'),
                'attr': {'class': 'space-y-4 pt-1'}
            }) }}

            <fieldset class="app-surface rounded-box p-3 sm:p-4">
                <legend class="px-2 text-sm font-semibold uppercase tracking-wide text-secondary">
                    {{ ux_icon('ph:game-controller', {class: 'mr-1 inline h-4 w-4'}) }}
                    {{ 'add_report.form.portable.label'|trans }}
                </legend>
                <div class="mt-2 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.is60FpsPortable, {'attr': {'class': checkboxClass}}) }}
                        <span>{{ form_label(createReportForm.is60FpsPortable) }}</span>
                    </label>
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.hasStableFrameratePortable, {'attr': {'class': checkboxClass}}) }}
                        <span>{{ form_label(createReportForm.hasStableFrameratePortable) }}</span>
                    </label>
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.hasResolutionImprovedPortable, {'attr': {
                            'class': checkboxClass,
                            'data-report-form-target': 'improvedPortable',
                            'data-action': 'report-form#improvedChanged'
                        }}) }}
                        <span>{{ form_label(createReportForm.hasResolutionImprovedPortable) }}</span>
                    </label>
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.isNativeResolutionPortable, {'attr': {
                            'class': checkboxClass,
                            'data-report-form-target': 'nativePortable',
                            'data-action': 'report-form#nativeChanged'
                        }}) }}
                        <span>{{ form_label(createReportForm.isNativeResolutionPortable) }}</span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="app-surface rounded-box p-3 sm:p-4">
                <legend class="px-2 text-sm font-semibold uppercase tracking-wide text-primary">
                    {{ ux_icon('ph:television', {class: 'mr-1 inline h-4 w-4'}) }}
                    {{ 'add_report.form.tv.label'|trans }}
                </legend>
                <div class="mt-2 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.is60FpsDocked, {'attr': {'class': checkboxClass}}) }}
                        <span>{{ form_label(createReportForm.is60FpsDocked) }}</span>
                    </label>
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.hasStableFramerateDocked, {'attr': {'class': checkboxClass}}) }}
                        <span>{{ form_label(createReportForm.hasStableFramerateDocked) }}</span>
                    </label>
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.hasResolutionImprovedDocked, {'attr': {
                            'class': checkboxClass,
                            'data-report-form-target': 'improvedDocked',
                            'data-action': 'report-form#improvedChanged'
                        }}) }}
                        <span>{{ form_label(createReportForm.hasResolutionImprovedDocked) }}</span>
                    </label>
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.isNativeResolutionDocked, {'attr': {
                            'class': checkboxClass,
                            'data-report-form-target': 'nativeDocked',
                            'data-action': 'report-form#nativeChanged'
                        }}) }}
                        <span>{{ form_label(createReportForm.isNativeResolutionDocked) }}</span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="app-surface rounded-box p-3 sm:p-4">
                <legend class="px-2 text-sm font-semibold uppercase tracking-wide text-accent">
                    {{ ux_icon('ph:sliders-horizontal', {class: 'mr-1 inline h-4 w-4'}) }}
                    {{ 'add_report.form.misc.label'|trans }}
                </legend>
                <div class="mt-2 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.hasImprovedLoadingTimes, {'attr': {'class': checkboxClass}}) }}
                        <span>{{ form_label(createReportForm.hasImprovedLoadingTimes) }}</span>
                    </label>
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.isPatched, {'attr': {'class': checkboxClass}}) }}
                        <span>{{ form_label(createReportForm.isPatched) }}</span>
                    </label>
                    <label class="{{ checkboxLabelClass }}">
                        {{ form_widget(createReportForm.isSwitch2Edition, {'attr': {'class': checkboxClass}}) }}
                        <span>{{ form_label(createReportForm.isSwitch2Edition) }}</span>
                    </label>
                    <label class="form-control gap-1 rounded-box border border-base-300/70 bg-base-100 px-3 py-2">
                        <span class="label-text text-sm font-medium">{{ form_label(createReportForm.gameStatus) }}</span>
                        {{ form_widget(createReportForm.gameStatus, {'attr': {'class': 'select select-bordered select-sm w-full focus:select-primary'}}) }}
                    </label>
                </div>
            </fieldset>

            <div class="rounded-box bg-info/10 p-3 text-xs leading-relaxed text-base-content/70">
                <p>{{ 'add_report.notice.stable_framerate'|trans }}</p>
                <p>{{ 'add_report.notice.resolution_improved'|trans }}</p>
                <p>{{ 'add_report.notice.native_resolution'|trans }}</p>
            </div>

            {{ form_widget(createReportForm.gameId, {'attr': {'value': game.id}}) }}
            {{ form_widget(createReportForm.gameSlug, {'attr': {'value': game.slug}}) }}
            {{ form_rest(createReportForm) }}

            <div class="flex justify-end">
                <button class="app-button-primary w-full sm:w-auto">
                    {{ ux_icon('ph:plus', {class: 'h-4 w-4'}) }}
                    {{ 'add_report.label'|trans }}
                </button>
            </div>

            {{ form_end(createReportForm) }}
        </div>
    </div>
</section>
