{% extends '@app/base.html.twig' %}

{% block content %}
    <h1>{{ game.name }}</h1>
    <a href="{{ path('create_report', {gameId: game.id}) }}">
        <button class="btn btn-primary">Generate</button>
    </a>

    {% for report in reports %}
        <h3>{{ report.upvoteCount }}</h3>
    {% endfor %}
{% endblock %}
