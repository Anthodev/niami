{% extends '@app/base.html.twig' %}

{% block content %}
    <div>
        <main class="app-shell py-6 sm:py-8 lg:py-10">
            <div class="space-y-5 sm:space-y-6">
                {% include '@reports/partials/_reports_game_info.html.twig' with { game: game, topReport: topReport } %}

                <section class="min-w-0" aria-label="{{ 'list.title'|trans({}, 'report') }}">
                    {% include '@reports/partials/_reports_list.html.twig' %}
                </section>
            </div>
        </main>

        <div
            class="report-sidebar-backdrop"
            data-report-sidebar-target="backdrop"
            data-action="click->report-sidebar#closeOnBackdrop"
            aria-hidden="true"
        ></div>

        <aside
            class="report-sidebar-panel"
            data-report-sidebar-target="panel"
            role="dialog"
            aria-modal="true"
            aria-hidden="true"
            aria-labelledby="add-report-title"
            inert
        >
            <div class="flex h-dvh flex-col">
                <div class="flex items-start justify-between gap-3 border-b border-base-300/70 p-4 sm:p-5">
                    <div class="min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-wide text-primary">{{ 'add_report.drawer.eyebrow'|trans({}, 'report') }}</p>
                        <h2 id="add-report-title" class="mt-1 text-xl font-bold text-base-content">{{ 'add_report.label'|trans({}, 'report') }}</h2>
                        <p class="mt-1 text-sm text-base-content/60">{{ 'add_report.subtitle'|trans({}, 'report') }}</p>
                    </div>
                    <button
                        type="button"
                        class="btn btn-ghost btn-sm btn-circle shrink-0 text-base-content/70 hover:text-primary"
                        data-action="report-sidebar#close"
                        aria-label="{{ 'add_report.drawer.close'|trans({}, 'report') }}"
                    >
                        {{ ux_icon('ph:x', {class: 'h-5 w-5'}) }}
                    </button>
                </div>

                <div class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-5">
                    {% include '@reports/partials/_reports_create_form.html.twig' %}
                </div>
            </div>
        </aside>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('upvote-manager') }}
{% endblock %}
