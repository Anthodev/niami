{% trans_default_domain 'search' %}

<turbo-frame id="search-results-frame">
    <div class="app-card overflow-hidden border-base-300/70 bg-base-100/95">
        <div id="search-results" class="p-4 sm:p-5 lg:p-6">
            {% if hasError %}
                <div class="alert alert-error items-start border border-error/30 shadow-none" aria-live="polite">
                    <span class="mt-0.5 h-5 w-5 shrink-0">{{ ux_icon('ph:x-circle') }}</span>
                    <span class="text-sm leading-6">{{ errorMessage }}</span>
                </div>
            {% else %}
                {% include '@app/partials/_game_search_results.html.twig' with {
                    'games': games,
                    'searchQuery': searchQuery
                } %}
            {% endif %}
        </div>
    </div>
</turbo-frame>
