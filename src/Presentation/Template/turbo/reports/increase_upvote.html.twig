<turbo-stream action="update" target="report-{{ reportId }}">
    <template>
        <div data-report-upvote data-report-id="{{ reportId }}" class="inline-flex items-center gap-2">
            <span class="btn btn-ghost btn-sm cursor-not-allowed rounded-full text-primary opacity-70" aria-disabled="true">
                <span id="upvote-count-{{ reportId }}" class="font-semibold">{{ reportUpvoteCount }}</span>
                {{ ux_icon('ph:arrow-fat-up-duotone', {class: 'h-4 w-4'}) }}
            </span>
            {% if reportId == mostUpvotedReportId %}
                <span class="tooltip text-warning" data-tip="Most upvoted" aria-label="Most upvoted">
                    {{ ux_icon('ph:star-fill', {class: 'h-5 w-5'}) }}
                </span>
            {% endif %}
        </div>
    </template>
</turbo-stream>
