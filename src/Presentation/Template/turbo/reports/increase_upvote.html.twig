<turbo-stream action="update" target="report-{{ reportId }}">
    <template>
        <div data-report-upvote data-report-id="{{ reportId }}">
            <span class="flex cursor-not-allowed text-decoration-none opacity-60">
                <div id="upvote-count-{{ reportId }}" class="bg-inherit opacity-100">{{ reportUpvoteCount }}</div>
                <div class="w-6 h-6 bg-inherit text-primary ml-1">
                    {{ ux_icon('ph:arrow-fat-up-duotone') }}
                </div>
            </span>
        </div>
        {% if reportId == mostUpvotedReportId %}
            <div class="w-6 h-6 bg-inherit text-yellow-300 ml-1">{{ ux_icon('ph:star-fill') }}</div>
        {% endif %}
    </template>
</turbo-stream>
