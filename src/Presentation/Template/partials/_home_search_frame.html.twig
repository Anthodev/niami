{% trans_default_domain 'search' %}

<div class="card bg-base-100 border border-primary/20 p-6 sm:p-8">
    <turbo-frame id="search-frame">
        {{ form_start(searchGamesForm, {
            'action': path('search_games'),
            'attr': {
                'data-controller': 'search-debounce',
                'data-search-debounce-delay-value': '1500',
                'data-search-debounce-min-length-value': '3',
                'data-turbo-frame': 'search-frame',
                'class': 'space-y-6'
            }
        }) }}
        <div class="form-control w-full">
            <label class="label">
                <span class="label-text text-lg font-medium text-base-content/80">{{ form_label(searchGamesForm.game) }}</span>
            </label>
            <div class="relative">
                {{ form_widget(searchGamesForm.game, {
                    'attr': {
                        'data-search-debounce-target': 'input',
                        'data-action': 'input->search-debounce#search',
                        'class': 'input input-bordered w-full bg-base-200/50 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all placeholder:text-base-content/40',
                        'placeholder': 'form.placeholder'|trans
                    }
                }) }}
                <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-base-content/30">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-full mt-4">
                <span class="w-5 h-5">{{ ux_icon('ph:magnifying-glass') }}</span>
                <span>{{ 'form.submit'|trans }}</span>
            </button>
        </div>

        {{ form_rest(searchGamesForm) }}

        <div class="label">
            <span class="label-text-alt text-base-content/50 text-center w-full block text-sm">
                {{ 'form.helper'|trans }}
            </span>
        </div>

        {{ form_end(searchGamesForm) }}

        <div id="search-results" class="mt-8">
        </div>
    </turbo-frame>
</div>
