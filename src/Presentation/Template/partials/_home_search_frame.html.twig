{% trans_default_domain 'search' %}

<div class="card bg-base-100 shadow-2xl border-2 border-base-300/50 p-6 sm:p-8 hover:shadow-3xl hover:border-base-300/70 transition-all duration-200">
    <turbo-frame id="search-frame">
        {{ form_start(searchGamesForm, {
            'action': path('search_games'),
            'attr': {
                'data-controller': 'search-debounce',
                'data-search-debounce-delay-value': '1500',
                'data-search-debounce-min-length-value': '3',
                'data-turbo-frame': 'search-frame',
                'class': 'space-y-6'
            }
        }) }}
        <div class="form-control w-full">
            <label class="label">
                <span class="label-text text-xl font-bold text-base-content/90">{{ form_label(searchGamesForm.game) }}</span>
            </label>
            <div class="relative group">
                {{ form_widget(searchGamesForm.game, {
                    'attr': {
                        'data-search-debounce-target': 'input',
                        'data-action': 'input->search-debounce#search',
                        'class': 'input input-bordered input-lg w-full text-lg bg-base-200/50 border-2 border-primary/20 focus:border-primary focus:bg-base-100 transition-all duration-200 ease-out placeholder:text-base-content/50',
                        'placeholder': 'form.placeholder'|trans
                    }
                }) }}
                <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none opacity-50 group-focus-within:opacity-100 transition-all duration-200 ease-out">
                    <svg class="w-6 h-6 text-primary transition-transform duration-200 ease-out group-focus-within:scale-105" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg gap-3 mt-4 shadow-lg hover:shadow-xl transform hover:scale-102 transition-all duration-150 ease-out bg-gradient-to-r from-primary to-primary-focus hover:from-primary-focus hover:to-primary">
                <span class="w-6 h-6">{{ ux_icon('ph:magnifying-glass') }}</span>
                <span class="font-semibold">{{ 'form.submit'|trans }}</span>
                <span class="w-4 h-4">{{ ux_icon('ph:arrow-right') }}</span>
            </button>
        </div>

        {{ form_rest(searchGamesForm) }}

        <div class="label">
            <span class="label-text-alt text-base-content/60 text-center w-full block">
                💡 {{ 'form.helper'|trans }}
            </span>
        </div>

        {{ form_end(searchGamesForm) }}

        <div id="search-results" class="mt-8">
            <!-- Search results will be loaded here via Turbo Frame -->
        </div>
    </turbo-frame>
</div>
