{% trans_default_domain 'search' %}

{% if games is not empty %}
    <div class="game-results">

        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-base-300/30">
            <span class="text-2xl font-light text-primary">{{ games|length }}</span>
            {% set gamePlural = games|length > 1 ? 's' : '' %}
            <span class="text-base-content/60">{{ 'form.results.label'|trans({'%gamePlural%': gamePlural}) }}</span>
            {% if searchQuery %}
                <span class="text-base-content/40 text-sm">{{ 'form.results.label_for'|trans({'%searchQuery%': searchQuery}) }}"</span>
            {% endif %}
        </div>

        <div class="grid gap-4">
            {% for game in games %}
                <div class="card bg-base-100 border border-base-300/50 hover:border-primary/30 transition-colors group">
                    <div class="card-body p-0">
                        <div class="flex flex-col sm:flex-row">
                            {% if game.imageCover is defined and game.name is defined %}
                                <div class="relative overflow-hidden sm:w-32 sm:h-32 w-full h-40 flex-shrink-0">
                                    <img src="{{ game.imageCover }}" alt="{{ game.name }}"
                                        class="w-full h-full object-cover">
                                </div>
                            {% endif %}

                            <div class="flex-1 p-5 space-y-3">
                                {% if game.name %}
                                    <h2 class="card-title text-xl font-semibold text-base-content group-hover:text-primary transition-colors">
                                        {{ game.name }}
                                    </h2>
                                {% endif %}

                                <div class="flex flex-wrap items-center gap-2">
                                    <div class="badge badge-sm bg-primary/10 text-primary border-primary/20">
                                        <span class="w-3 h-3">{{ ux_icon('ph:calendar-dots') }}</span>
                                        <span>{{ game.releaseDate|date('d/m/Y') }}</span>
                                    </div>

                                    {% if game.developer is defined and game.developer != '' %}
                                        <div class="badge badge-sm bg-base-200 text-base-content/70 border-base-300">
                                            <span class="w-3 h-3">{{ ux_icon('ph:game-controller') }}</span>
                                            <span>{{ game.developer.name }}</span>
                                        </div>
                                    {% endif %}

                                    {% if game.publisher is defined and game.publisher != '' %}
                                        <div class="badge badge-sm bg-base-200 text-base-content/70 border-base-300">
                                            <span class="w-3 h-3">{{ ux_icon('ph:building-apartment') }}</span>
                                            <span>{{ game.publisher.name }}</span>
                                        </div>
                                    {% endif %}
                                </div>

                                {% if game.description is defined %}
                                    <p class="text-left text-base-content/70 text-sm leading-relaxed line-clamp-3">
                                        {{ game.description|raw }}
                                    </p>
                                {% endif %}

                                <div class="card-actions justify-end pt-2">
                                    <a href="{{ path('reports_for_game', {gameSlug: game.slug}) }}" data-turbo-frame="_top">
                                        <button class="btn btn-sm btn-primary">
                                            <span class="w-4 h-4">{{ ux_icon('ph:files') }}</span>
                                            <span>{{ 'card.view_reports_button'|trans }}</span>
                                        </button>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% else %}
    <div class="no-results">
        {% if searchQuery %}
            <div class="alert bg-base-200 border border-base-300/50">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-primary shrink-0 w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                    <h3 class="font-medium text-base-content">{{ 'form.results.no_results.label'|trans }}</h3>
                    <div class="text-sm text-base-content/60">{{ 'form.results.no_results.message'|trans({'%searchQuery%': searchQuery})|raw }}</div>
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
