{% if games is not empty %}
    <div class="game-results">
        <div class="stats shadow mb-6">
            <div class="stat">
                <div class="stat-figure text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div class="stat-value text-success">{{ games|length }}</div>
                <div class="stat-title">Game{{ games|length > 1 ? 's' : '' }} found</div>
                {% if searchQuery %}
                    <div class="stat-desc">for "{{ searchQuery }}"</div>
                {% endif %}
            </div>
        </div>

        <div class="grid gap-4">
            {% for game in games %}
                <div class="card border-2 border-indigo-600 bg-base-100 shadow-md hover:shadow-lg transition-shadow duration-200">
                    <div class="card-body">
                        <div class="flex gap-4">
                            {% if game.imageCover is defined and game.name is defined %}
                                <img src="{{ game.imageCover }}" alt="{{ game.name }}" class="w-32 h-32 object-cover">
                            {% endif %}
                            <div>
                                {% if game.name %}
                                    <h1 class="card-title text-primary">
                                        {{ game.name }}
                                    </h1>
                                {% endif %}

                                <div class="flex items-center gap-2 my-2">
                                    {% if game.releaseDate is defined %}
                                        <div class="badge badge-outline badge-sm gap-2">
                                            <span class="w-4 h-4">{{ ux_icon('ph:calendar-dots') }}</span>
                                            {{ game.releaseDate|date('d/m/Y') }}
                                        </div>
                                    {% endif %}

                                    {% if game.publisher is defined %}
                                        <div class="badge badge-outline badge-primary badge-sm">Publisher: {{ game.publisher }}</div>
                                    {% endif %}
                                </div>

                                {% if game.description is defined %}
                                    <p class="text-left text-base-content/70">
                                        {{ game.description|length > 500 ? game.description|slice(0, 500) ~ '...' : game.description }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>

                        <div class="card-actions justify-end items-center mt-2">
                            <button class="btn btn-primary btn-sm inline-flex items-center gap-2">
                                <span class="w-4 h-4">{{ ux_icon('ph:files') }}</span>
                                See the reports
                                <span class="w-4 h-4">{{ ux_icon('ph:greater-than') }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% else %}
    <div class="no-results">
        {% if searchQuery %}
            <div class="alert alert-info">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-info shrink-0 w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                    <h3 class="font-bold">No results found</h3>
                    <div class="text-xs">No game found for <strong>"{{ searchQuery }}"</strong>. Search again with others terms.</div>
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
