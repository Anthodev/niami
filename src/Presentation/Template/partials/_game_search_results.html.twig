{% if games is not empty %}
    <div class="game-results">
        <div class="stats shadow mb-6">
            <div class="stat">
                <div class="stat-figure text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div class="stat-title">Résultats trouvés</div>
                <div class="stat-value text-success">{{ games|length }}</div>
                {% if searchQuery %}
                    <div class="stat-desc">pour "{{ searchQuery }}"</div>
                {% endif %}
            </div>
        </div>

        <div class="grid gap-4">
            {% for game in games %}
                <div class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow duration-200">
                    <div class="card-body">
                        <h2 class="card-title text-primary">
                            {{ game.name }}
                        </h2>

                        {% if game.description %}
                            <p class="text-base-content/70">
                                {{ game.description|length > 150 ? game.description|slice(0, 150) ~ '...' : game.description }}
                            </p>
                        {% endif %}

                        <div class="card-actions justify-between items-center mt-4">
                            {% if game.releaseDate %}
                                <div class="badge badge-outline gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                    {{ game.releaseDate|date('d/m/Y') }}
                                </div>
                            {% endif %}

                            <button class="btn btn-primary btn-sm">
                                Voir détails
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% else %}
    <div class="no-results">
        {% if searchQuery %}
            <div class="alert alert-info">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-info shrink-0 w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                    <h3 class="font-bold">Aucun résultat trouvé</h3>
                    <div class="text-xs">Aucun jeu trouvé pour <strong>"{{ searchQuery }}"</strong>. Essayez avec d'autres termes de recherche.</div>
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
