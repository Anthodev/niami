{% if games is not empty %}
    <div class="game-results animate-fade-in">

        <div class="stats bg-base-100 shadow-2xl border border-base-300/50 mb-8 hover:shadow-3xl transition-shadow duration-200 hover:border-base-300/70">
            <div class="stat">
                <div class="stat-figure text-success">
                    <div class="w-12 h-12 bg-success/20 rounded-full flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                </div>
                <div class="stat-value text-success text-4xl font-black">{{ games|length }}</div>
                <div class="stat-title text-lg font-semibold">Jeu{{ games|length > 1 ? 'x' : '' }} trouvé{{ games|length > 1 ? 's' : '' }}</div>
                {% if searchQuery %}
                    <div class="stat-desc text-base-content/70">pour "{{ searchQuery }}"</div>
                {% endif %}
            </div>
        </div>

        <div class="grid gap-6 sm:gap-8">
            {% for game in games %}
                <div class="card glass bg-base-100 border-2 border-base-300/50 shadow-2xl hover:shadow-3xl hover:scale-[1.01] hover:border-base-300/80 transition-all duration-200 ease-out group overflow-hidden">
                    <div class="card-body p-0">
                        <div class="flex flex-col sm:flex-row">
                            {% if game.imageCover is defined and game.name is defined %}
                                <div class="relative overflow-hidden sm:w-40 sm:h-40 w-full h-48 flex-shrink-0">
                                    <img src="{{ game.imageCover }}" alt="{{ game.name }}"
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200 ease-out">
                                </div>
                            {% endif %}

                            <div class="flex-1 px-6 pb-6 space-y-4">
                                {% if game.name %}
                                    <h2 class="card-title text-2xl font-black text-primary group-hover:text-primary-focus transition-colors">
                                        {{ game.name }}
                                    </h2>
                                {% endif %}

                                <div class="flex flex-wrap items-center gap-3">
                                    <div class="badge badge-outline badge-lg gap-2 border-primary/30 hover:bg-primary/10 transition-colors">
                                        <span class="w-4 h-4 text-primary">{{ ux_icon('ph:calendar-dots') }}</span>
                                        <span class="font-medium">{{ game.releaseDate|date('d/m/Y') }}</span>
                                    </div>

                                    {% if game.developer is defined and game.developer != '' %}
                                        <div class="flex badge badge-outline badge-secondary badge-lg font-medium">
                                            <div class="w-6 h-6">{{ ux_icon('ph:game-controller') }}</div>
                                            <div>{{ game.developer.name }}</div>
                                        </div>
                                    {% endif %}

                                    {% if game.publisher is defined and game.publisher != '' %}
                                        <div class="flex badge badge-outline badge-accent badge-lg font-medium">
                                            <div class="w-6 h-6">{{ ux_icon('ph:building-apartment') }}</div>
                                            <div>{{ game.publisher.name }}</div>
                                        </div>
                                    {% endif %}
                                </div>

                                {% if game.description is defined %}
                                    <p class="text-left text-base-content/80 leading-relaxed line-clamp-5">
                                        {{ game.description|raw }}
                                    </p>
                                {% endif %}

                                <div class="card-actions justify-end pt-4">
                                    <a href="{{ path('reports_for_game', {gameSlug: game.slug}) }}" data-turbo-frame="_top">
                                        <button class="btn btn-primary btn-lg gap-3 shadow-lg hover:shadow-xl transform hover:scale-102 transition-all duration-150 ease-out bg-gradient-to-r from-primary to-primary-focus hover:from-primary-focus hover:to-primary">
                                            <span class="w-5 h-5">{{ ux_icon('ph:files') }}</span>
                                            <span class="font-semibold">Voir les rapports</span>
                                            <span class="w-4 h-4">{{ ux_icon('ph:arrow-right') }}</span>
                                        </button>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% else %}
    <div class="no-results">
        {% if searchQuery %}
            <div class="alert alert-info">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-info shrink-0 w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                    <h3 class="font-bold">No results found</h3>
                    <div class="text-xs">No game found for <strong>"{{ searchQuery }}"</strong>. Search again with others terms.</div>
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
