<header class="sticky top-0 z-50 border-b border-base-300/60 bg-base-100/85 shadow-sm backdrop-blur supports-[backdrop-filter]:bg-base-100/70">
    <nav class="mx-auto flex min-h-16 w-full max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8" aria-label="Navigation principale">
        <a href="{{ path('homepage') }}" class="btn btn-ghost min-h-11 gap-2 rounded-box px-2 text-base font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:px-3 sm:text-xl">
            {{ ux_icon('ph:game-controller-duotone', {class: 'h-7 w-7 text-primary', 'aria-hidden': 'true'}) }}
            <span class="text-primary">NIAMI</span>
        </a>

        {% if searchGamesForm is defined %}
            <form
                action="{{ path('search_games') }}"
                method="post"
                class="hidden !hidden flex-1 items-center justify-center lg:flex"
                data-controller="navbar-search"
                data-navbar-search-hidden-class="!hidden"
                data-turbo-frame="search-results-frame"
                aria-hidden="true"
            >
                {% if searchGamesForm._token is defined %}
                    <input
                        type="hidden"
                        name="{{ searchGamesForm._token.vars.full_name|e('html_attr') }}"
                        value="{{ searchGamesForm._token.vars.value|e('html_attr') }}"
                    >
                {% endif %}
                <label for="navbar-search-game" class="sr-only">{{ searchGamesForm.game.vars.label }}</label>
                <div class="relative w-full max-w-md">
                    <input
                        id="navbar-search-game"
                        type="search"
                        name="{{ searchGamesForm.game.vars.full_name }}"
                        class="input input-bordered input-sm w-full rounded-box border-base-300 bg-base-200/70 pl-9 pr-3 text-sm text-base-content placeholder:text-base-content/45 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
                        placeholder="{{ searchGamesForm.game.vars.attr.placeholder|default('') }}"
                        autocomplete="off"
                    >
                    <span class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-base-content/40">
                        {{ ux_icon('ph:magnifying-glass') }}
                    </span>
                </div>
            </form>
        {% endif %}

        <div class="flex items-center gap-1" data-controller="theme">
            {% if createReportForm is defined %}
                <button
                    type="button"
                    class="btn btn-primary btn-sm rounded-box gap-2 shadow-none"
                    data-action="report-sidebar#open"
                >
                    {{ ux_icon('ph:plus', {class: 'h-4 w-4'}) }}
                    <span class="hidden sm:inline">{{ 'add_report.label'|trans({}, 'report') }}</span>
                </button>
            {% endif %}
            <label class="swap swap-rotate btn btn-ghost btn-circle inline-grid h-11 min-h-11 w-11 place-items-center items-center justify-center p-0 text-base-content/80 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary" aria-label="Changer de thème">
                <input
                    type="checkbox"
                    aria-label="Basculer entre thème sombre et thème clair"
                    data-theme-target="toggle"
                    data-action="change->theme#toggle"
                />
                <svg class="swap-on h-6 w-6 shrink-0 fill-current" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/></svg>
                <svg class="swap-off h-6 w-6 shrink-0 fill-current" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/></svg>
            </label>
        </div>
    </nav>
</header>
