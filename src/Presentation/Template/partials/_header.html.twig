<header class="navbar bg-base-100 shadow-lg border-b border-base-300/50 sticky top-0 z-50">
    <div class="navbar-start">
        <a href="{{ path('homepage') }}" class="btn btn-ghost text-xl font-bold hover:scale-105 transition-all duration-300 ease-out">
            <span class="text-2xl">🎮</span>
            <span class="hidden sm:inline bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">NS2 UBCR</span>
        </a>
    </div>
    <div class="navbar-end">
        <div class="flex items-center gap-3" data-controller="theme">
            <div class="tooltip tooltip-bottom" data-tip="Toggle theme">
                <label class="flex items-center gap-2 cursor-pointer hover:bg-base-200/50 p-2 rounded-lg transition-all duration-300 ease-out hover:scale-105">
                    <span class="text-lg">🌙</span>
                    <input type="checkbox" class="toggle toggle-primary toggle-sm" onclick="toggleTheme()" />
                    <span class="text-lg">🌞</span>
                </label>
            </div>
        </div>
    </div>
</header>

<script lang="text/javascript">
    function toggleTheme() {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'plumber-dark' ? 'plumber-light' : 'plumber-dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
    }

    const savedTheme = localStorage.getItem('theme') || 'plumber-dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
</script>
