{% trans_default_domain 'home' %}
{% extends "@app/base.html.twig" %}

{% block content %}
    <div class="min-h-[80vh] flex items-center justify-center px-6 py-20">
        <div class="max-w-4xl w-full text-center space-y-12">
            <div class="space-y-6">
                <p class="text-primary text-sm tracking-widest uppercase font-medium">Nintendo Switch 2</p>
                <h1 class="text-5xl md:text-7xl font-light text-base-content tracking-tight">
                    {{ 'content.title'|trans }}
                </h1>
                <p class="text-lg text-base-content/60 max-w-xl mx-auto font-light leading-relaxed">
                    {{ 'content.subtitle'|trans }}
                </p>
            </div>

            <div class="max-w-2xl mx-auto">
                {% include "@app/partials/_home_search_frame.html.twig" %}
            </div>
        </div>
    </div>
{% endblock %}
