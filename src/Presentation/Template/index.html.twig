{% extends "@app/base.html.twig" %}

{% block content %}
    <div class="hero min-h-screen">
        <div class="hero-content text-center">
            <div class="max-w-2xl">
                <h1 class="text-5xl font-bold text-success mb-8">
                    <span class="text-gradient bg-gradient-to-r from-success to-info bg-clip-text text-transparent">
                        HELLO!
                    </span>
                </h1>

                <div class="card bg-base-100 shadow-xl p-8">
                    <turbo-frame id="search-frame">
                        {{ form_start(searchGamesForm, {
                            'action': path('search_games'),
                            'attr': {
                                'data-controller': 'search-debounce',
                                'data-search-debounce-delay-value': '500',
                                'data-search-debounce-min-length-value': '3',
                                'data-turbo-frame': 'search-frame',
                                'class': 'space-y-6'
                            }
                        }) }}
                        <div class="form-control w-full">
                            <label class="label">
                                <span class="label-text text-lg font-semibold">{{ form_label(searchGamesForm.game) }}</span>
                            </label>
                            {{ form_widget(searchGamesForm.game, {
                                'attr': {
                                    'data-search-debounce-target': 'input',
                                    'data-action': 'input->search-debounce#search',
                                    'class': 'input input-bordered input-primary w-full text-lg',
                                    'placeholder': 'Tapez au moins 3 caractères pour rechercher...'
                                }
                            }) }}
                            <label class="label">
                                <span class="label-text-alt">La recherche se lance automatiquement après 3 caractères</span>
                            </label>
                        </div>

                        {{ form_rest(searchGamesForm) }}

                        <button type="submit" class="btn btn-primary btn-lg w-full gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            Rechercher maintenant
                        </button>
                        {{ form_end(searchGamesForm) }}

                        <div id="search-results" class="mt-8">
                            <!-- Search results will be loaded here via Turbo Frame -->
                        </div>
                    </turbo-frame>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
